# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored. Do not share keys between
# developers; request your own and rotate it if it may have leaked.

# --- Text-LLM configuration --------------------------------------------------
# The pin-extraction LLM runs against any OpenAI-compatible endpoint. With none
# of the LLM_* vars set, it uses the self-hosted FastChat box + llama-3 (the
# historical default). To switch models/providers, set these three — no code
# change needed. Example (OpenRouter):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=<your OpenRouter key>
#   LLM_MODEL=openai/gpt-6-luna
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Agentic repair (POST /agentic) ------------------------------------------
# Vision model used only when the cheap repair step cannot resolve a grouped
# pin label from text (e.g. SEGA:SEGG blocks that only the pinout drawing
# resolves). Needs a vision-capable provider (OpenRouter). Default shown.
AGENTIC_ESCALATION_MODEL=anthropic/claude-opus-4.8

# Legacy name for the FastChat key; still honored as a fallback when
# LLM_API_KEY is unset. Prefer LLM_API_KEY for new setups.
FASTCHAT_API_KEY=

# Vision API endpoint override (currently unused by the code — the qwen
# endpoints are hardcoded; see review issue SEC-002).
IMAGE_AI_URL=
