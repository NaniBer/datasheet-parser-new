# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored. Do not share keys between
# developers; request your own and rotate it if it may have leaked.

# Bearer token for the FastChat text-LLM API (https://fastchat.ideeza.com/v1).
# Required for LLM-based pin extraction; runs that succeed with the
# deterministic table parser work without it.
FASTCHAT_API_KEY=

# Vision API endpoint override (currently unused by the code — the qwen
# endpoints are hardcoded; see review issue SEC-002).
IMAGE_AI_URL=
